// Schéma de la base NetForge.
// L'URL de connexion est fournie par prisma.config.ts (variable DATABASE_URL).

generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

/// Compte NetForge : adresse e-mail et mot de passe (phase 5).
model User {
  id                 String       @id @default(uuid()) @db.Uuid
  /// Adresse telle que saisie (envoi et affichage).
  email              String       @db.VarChar(254)
  /// Clé de comparaison unique (politique unique, voir auth/email.ts).
  emailKey           String       @unique @map("email_key") @db.VarChar(254)
  /// Empreinte Argon2id au format PHC ; le mot de passe n'est jamais stocké.
  passwordHash       String       @map("password_hash") @db.VarChar(255)
  /// Null tant que l'adresse n'est pas validée : aucun accès aux données privées.
  emailVerifiedAt    DateTime?    @map("email_verified_at") @db.Timestamptz(3)
  /// Incrémentée à chaque changement d'identifiants : les jetons émis avant deviennent inutilisables.
  credentialsVersion Int          @default(1) @map("credentials_version")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  sessions           Session[]
  tokens             EmailToken[]
  projects           Project[]
  exercises          Exercise[]
  publications       Publication[]
  attempts           Attempt[]

  @@map("users")
}

/// Exercice rédigé par un compte, privé à son auteur (format « netforge-exercise » validé par le moteur).
model Exercise {
  id           String        @id @default(uuid()) @db.Uuid
  ownerId      String        @map("owner_id") @db.Uuid
  owner        User          @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title        String        @db.VarChar(120)
  /// Contenu complet, critères et bonnes réponses compris : jamais envoyé à un élève.
  content      Json          @db.Json
  revision     Int           @default(1)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  publications Publication[]

  @@index([ownerId, updatedAt])
  @@map("exercises")
}

/// Évaluation publiée : instantané immuable d'une révision d'exercice, joignable par un code non devinable.
model Publication {
  id               String    @id @default(uuid()) @db.Uuid
  code             String    @unique @db.VarChar(16)
  ownerId          String    @map("owner_id") @db.Uuid
  owner            User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  /// Exercice d'origine ; l'instantané reste valable si l'exercice est supprimé.
  exerciseId       String?   @map("exercise_id") @db.Uuid
  exercise         Exercise? @relation(fields: [exerciseId], references: [id], onDelete: SetNull)
  exerciseRevision Int       @map("exercise_revision")
  title            String    @db.VarChar(120)
  content          Json      @db.Json
  /// SHA-256 du contenu de l'instantané (versionnement des évaluations).
  contentHash      String    @map("content_hash") @db.Char(64)
  maxAttempts      Int       @map("max_attempts")
  closedAt         DateTime? @map("closed_at") @db.Timestamptz(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  attempts         Attempt[]

  @@index([exerciseId, createdAt])
  @@map("publications")
}

/// Tentative d'un élève : indices comptés par le serveur ; résultat immuable une fois noté.
model Attempt {
  id               String      @id @default(uuid()) @db.Uuid
  publicationId    String      @map("publication_id") @db.Uuid
  publication      Publication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  userId           String      @map("user_id") @db.Uuid
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  hintsRevealed    Int         @default(0) @map("hints_revealed")
  startedAt        DateTime    @default(now()) @map("started_at") @db.Timestamptz(3)
  submittedAt      DateTime?   @map("submitted_at") @db.Timestamptz(3)
  score            Int?
  maxScore         Int         @map("max_score")
  /// Détail par étape, versions du correcteur et du moteur.
  result           Json?       @db.Json
  evaluatorVersion Int?        @map("evaluator_version")
  engineVersion    String?     @map("engine_version") @db.VarChar(32)
  /// SHA-256 de la soumission notée (projet et réponses).
  submissionHash   String?     @map("submission_hash") @db.Char(64)

  @@index([userId, startedAt])
  @@index([publicationId, userId])
  @@map("attempts")
}

enum TokenPurpose {
  VERIFY_EMAIL   @map("verify_email")
  RESET_PASSWORD @map("reset_password")

  @@map("token_purpose")
}

/// Jeton à usage unique envoyé par e-mail (validation d'adresse, réinitialisation).
model EmailToken {
  id                 String       @id @default(uuid()) @db.Uuid
  userId             String       @map("user_id") @db.Uuid
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose            TokenPurpose
  /// SHA-256 (hexadécimal) du secret envoyé ; le secret lui-même n'est jamais stocké.
  tokenHash          String       @unique @map("token_hash") @db.Char(64)
  /// Version des identifiants à l'émission : un changement de mot de passe invalide le jeton.
  credentialsVersion Int          @map("credentials_version")
  expiresAt          DateTime     @map("expires_at") @db.Timestamptz(3)
  /// Renseignée de façon atomique à la consommation (une seule réussite possible).
  consumedAt         DateTime?    @map("consumed_at") @db.Timestamptz(3)
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, purpose])
  @@map("email_tokens")
}

/// Session opaque révocable : le cookie porte le secret, la base son empreinte.
model Session {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 (hexadécimal) du secret du cookie.
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Dernière activité (inactivité) ; mise à jour au plus une fois par minute.
  lastUsedAt DateTime  @map("last_used_at") @db.Timestamptz(3)
  /// Échéance absolue, jamais prolongée.
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

/// Compteur anti-abus partagé entre instances (fenêtre fixe, incrément atomique).
model RateLimit {
  key       String   @id @db.VarChar(200)
  count     Int
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)

  @@index([expiresAt])
  @@map("rate_limits")
}

/// Projet NetForge privé, enregistré dans le compte de son propriétaire (format .nfg.json).
model Project {
  id            String   @id @db.Uuid
  ownerId       String   @map("owner_id") @db.Uuid
  owner         User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name          String   @db.VarChar(120)
  /// Version du schéma .nfg.json du contenu, pour les migrations explicites.
  schemaVersion Int      @map("schema_version")
  /// Contenu validé du projet, conservé tel quel (type json : l'ordre des clés et donc l'export restent identiques).
  content       Json     @db.Json
  /// Révision incrémentée à chaque sauvegarde : détection des conflits.
  revision      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([ownerId, updatedAt])
  @@map("projects")
}
