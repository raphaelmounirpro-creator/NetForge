# Copier ce fichier vers apps/api/.env (jamais versionné).
# Valeurs de développement local uniquement : ne pas les réutiliser en production.

# development | test | production
NODE_ENV=development

# Port HTTP de l'API (routes servies sous /api)
PORT=3000

# PostgreSQL local : Docker Compose (pnpm db:up) ou base embarquée (pnpm db:local)
DATABASE_URL=postgresql://netforge:netforge_dev@localhost:5432/netforge

# Origine publique de l'interface : liens des courriers et contrôle CSRF de l'en-tête Origin.
# Obligatoire et en HTTPS en production (cookies __Host-, Secure).
APP_ORIGIN=http://localhost:5173

# Clé HMAC des jetons CSRF, 32 caractères au moins. Obligatoire en production, identique
# sur toutes les instances. Génération : node -e "console.log(crypto.randomBytes(32).toString('base64url'))"
# Laissée vide en développement : clé aléatoire propre au processus.
CSRF_SECRET=

# Proxys de confiance pour l'adresse cliente : false (aucun), loopback, ou nombre de sauts (1 à 9).
TRUST_PROXY=false

# Courrier : boîte de développement locale (pnpm mail:local, lecture sur http://localhost:8025).
# En production : serveur SMTP du fournisseur validé (identifiants hors du dépôt), soit par
# SMTP_URL, soit par SMTP_HOST, SMTP_PORT (465 ou 587), SMTP_USER et SMTP_PASSWORD (secrets Vercel).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=NetForge (local) <netforge@localhost>

# Durées (valeurs par défaut documentées dans docs/securite.md) :
# VERIFY_TOKEN_TTL_MINUTES=1440
# RESET_TOKEN_TTL_MINUTES=30
# RESEND_MIN_SECONDS=60
# SESSION_IDLE_MINUTES=60
# SESSION_ABSOLUTE_HOURS=12
